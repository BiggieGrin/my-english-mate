# Copy to .env and fill in real values. Never commit .env.

# Supabase — safe to expose, these ship in the browser bundle
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Gemini — SECRET. Local dev only.
# Edge functions read this from Supabase secrets, not from here:
#   supabase secrets set GEMINI_API_KEY=<key>
GEMINI_API_KEY=""
